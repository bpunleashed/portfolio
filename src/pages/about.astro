---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

// Základná cesta pre GitHub Pages (na GitHube /portfolio, na laptope '')
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Inteligentné zlučovanie tagov (ignoruje rozdiely vo veľkých/malých písmenách)
const skillMap: Record<string, { name: string; count: number }> = {};

allProjects.forEach(p => {
  const projectSkills = new Set(
    (p.data.skills || []).map((s: string) => s.trim()).filter(Boolean)
  );

  projectSkills.forEach(skill => {
    const key = skill.toLowerCase();
    if (!skillMap[key]) {
      skillMap[key] = { name: skill, count: 0 };
    }
    skillMap[key].count += 1;
  });
});

const sortedSkills = Object.values(skillMap).sort((a, b) => {
  if (b.count !== a.count) return b.count - a.count;
  return a.name.localeCompare(b.name);
});
