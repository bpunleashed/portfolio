---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

// Pomocná funkcia: inteligentne prepočíta textový dátum na časovú pečiatku
function parseProjectDate(dateStr: string): number {
  if (!dateStr) return 0;
  const parsed = Date.parse(dateStr);
  if (!isNaN(parsed)) return parsed;

  const years = dateStr.match(/\b(20\d\d|19\d\d)\b/g);
  if (years && years.length > 0) {
    const maxYear = Math.max(...years.map(Number));
    const lower = dateStr.toLowerCase();
    
    const months: [string, number][] = [
      ['jan', 1], ['feb', 2], ['mar', 3], ['marec', 3],
      ['apr', 4], ['apríl', 4], ['máj', 5], ['may', 5],
      ['jún', 6], ['jun', 6], ['júl', 7], ['jul', 7],
      ['aug', 8], ['sep', 9], ['okt', 10], ['oct', 10],
      ['nov', 11], ['dec', 12]
    ];

    let month = 1;
    for (const [mName, mNum] of months) {
      if (lower.includes(mName)) {
        month = mNum;
        break;
      }
    }
    return new Date(maxYear, month - 1, 1).getTime();
  }
  return 0;
}

// 1. Načítanie projektov a chronologické zoradenie
const rawProjects: any[] = await getCollection('projects');
const projects: any[] = rawProjects.sort((a, b) => {
  return parseProjectDate(b.data.date) - parseProjectDate(a.data.date);
});

// 2. Prekladový slovník zlučujúci duplicity do jedného filtra
const skillTranslations: Record<string, { en: string; sk: string; aliases: string[] }> = {
  'camera': { 
    en: 'Camera (DP)', 
    sk: 'Kamera', 
    aliases: ['camera (dp)', 'camera', 'video recording', 'kamera', 'dop'] 
  },
  'directing': { 
    en: 'Directing', 
    sk: 'Réžia', 
    aliases: ['directing', 'réžia', 'rezia', 'director', 'directed', 'režisér'] 
  },
  'video-editing': { 
    en: 'Video Editing', 
    sk: 'Strih videa', 
    aliases: ['video editing', 'editing', 'strih videa', 'strih', 'edit', 'editor'] 
  },
  'location-sound': { 
    en: 'Location Sound', 
    sk: 'Lokačný zvuk', 
    aliases: ['location sound', 'sound', 'sound recording', 'zvuk', 'lokačný zvuk'] 
  },
  'sound-design': { 
    en: 'Sound Design', 
    sk: 'Zvukový dizajn', 
    aliases: ['sound design', 'sound engineering', 'zvukový dizajn'] 
  },
  'preproduction': { 
    en: 'Preproduction', 
    sk: 'Predprodukcia', 
    aliases: ['preproduction', 'pre-production', 'predprodukcia', 'príprava'] 
  },
  'photography': { 
    en: 'Photography', 
    sk: 'Fotografia', 
    aliases: ['photography', 'foto', 'fotografia'] 
  },
  'photo-editing': { 
    en: 'Photo Editing', 
    sk: 'Úprava fotiek', 
    aliases: ['photo editing', 'úprava fotiek', 'retuš'] 
  },
  'stop-motion': { 
    en: 'Stop-Motion', 
    sk: 'Stop-motion', 
    aliases: ['stop-motion', 'stop motion', 'animácia'] 
  },
  'prop-making': { 
    en: 'Prop Making', 
    sk: 'Výroba rekvizít', 
    aliases: ['prop making', 'výroba rekvizít', 'props'] 
  },
  'woodworking': { 
    en: 'Woodworking', 
    sk: 'Práca s drevom', 
    aliases: ['woodworking', 'woodwork', 'práca s drevom', 'drevorezba'] 
  },
  'grip': { 
    en: 'Grip', 
    sk: 'Grip', 
    aliases: ['grip', 'osvetľovač'] 
  },
  'storyboarding': { 
    en: 'Storyboarding', 
    sk: 'Storyboarding', 
    aliases: ['story boarding', 'storyboarding', 'scenár'] 
  },
  'event-management': { 
    en: 'Event Management', 
    sk: 'Event produkcia', 
    aliases: ['event management', 'event produkcia', 'produkcia'] 
  },
  'stage-presence': { 
    en: 'Stage Presence', 
    sk: 'Javisková tvorba', 
    aliases: ['stage presence', 'divadlo', 'javisková tvorba'] 
  },
  'painting': { 
    en: 'Painting', 
    sk: 'Maľba', 
    aliases: ['painting', 'maľba', 'výtvarné umenie'] 
  },
  'sewing': { 
    en: 'Sewing / Costumes', 
    sk: 'Šitie / Kostýmy', 
    aliases: ['sewing', 'šitie', 'kostýmy'] 
  },
  'craft-services': { 
    en: 'Craft Services', 
    sk: 'Servis na pľaci', 
    aliases: ['craft services', 'servis na pľaci', 'runner'] 
  }
};

// 3. Extrakcia tagov, ktoré sa reálne v projektoch nachádzajú
const usedTagsSet = new Set<string>();
projects.forEach((p: any) => {
  (p.data.skills || []).forEach((s: string) => {
    if (s && typeof s === 'string') usedTagsSet.add(s.trim().toLowerCase());
  });
});

// Vygenerujeme zoznam tlačidiel (zjednotené podľa slovníka + bezpečný fallback pre neznáme tagy)
const processedKeys = new Set<string>();
const displaySkills: { id: string; en: string; sk: string; matchAliases: string[] }[] = [];

for (const [key, data] of Object.entries(skillTranslations)) {
  const isPresent = data.aliases.some(alias => usedTagsSet.has(alias));
  if (isPresent) {
    displaySkills.push({
      id: key,
      en: data.en,
      sk: data.sk,
      matchAliases: data.aliases
    });
    data.aliases.forEach(a => processedKeys.add(a));
  }
}

// Fallback pre prípadné tagy v databáze, ktoré by neboli v slovníku
usedTagsSet.forEach(rawTag => {
  if (!processedKeys.has(rawTag)) {
    displaySkills.push({
      id: rawTag,
      en: rawTag.charAt(0).toUpperCase() + rawTag.slice(1),
      sk: rawTag.charAt(0).toUpperCase() + rawTag.slice(1),
      matchAliases: [rawTag]
    });
  }
});
---

<Layout>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Hero Header s okamžitým prepínaním jazykov -->
    <section class="mb-12 max-w-3xl">
      <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-4">
        <span class="lang-en">Explore my work</span>
        <span class="lang-sk hidden">Pozrite si moju tvorbu</span>
      </h1>
      <p class="text-neutral-400 text-base leading-relaxed">
        <span class="lang-en">Freelance filmmaker, location sound mixer, and editor based between Košice and Trnava. Specializing in independent narrative, event media, and practical physical arts.</span>
        <span class="lang-sk hidden">Nezávislý filmár, lokačný zvukár a strihač pôsobiaci medzi Košicami a Trnavou. Zameriavam sa na hranú a dokumentárnu tvorbu, festivalové médiá a výtvarné umenie.</span>
      </p>
    </section>

    <!-- Automaticky generované filter tlačidlá s 2 jazykmi -->
    <section class="mb-10">
      <p class="text-xs font-mono uppercase tracking-wider text-neutral-500 mb-3">
        <span class="lang-en">Filter by Skill / Discipline:</span>
        <span class="lang-sk hidden">Filtrovať podľa zamerania:</span>
      </p>
      
      <div class="flex flex-wrap gap-2" id="filter-buttons">
        <!-- Tlačidlo VŠETKO -->
        <button data-filter="all" class="filter-btn active px-3.5 py-1.5 text-xs font-mono rounded bg-amber-500 text-black font-bold transition-all">
          <span class="lang-en">All</span><span class="lang-sk hidden">Všetko</span> ({projects.length})
        </button>

        <!-- Dvojjazyčné tagy -->
        {displaySkills.map((skill) => (
          <button 
            data-filter={skill.matchAliases.join(',')} 
            class="filter-btn px-3.5 py-1.5 text-xs font-mono rounded bg-neutral-900 border border-neutral-800 text-neutral-300 hover:border-neutral-600 transition-all"
          >
            <span class="lang-en">{skill.en}</span>
            <span class="lang-sk hidden">{skill.sk}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- Grid kariet projektov (zoradený od najnovších) -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8" id="projects-grid">
      {projects.map((project: any) => (
        <ProjectCard project={project} />
      ))}
    </section>
  </div>
</Layout>

<!-- Klientsky filter skript s podporou aliasov a prepínania -->
<script is:inline>
  function setupProjectsFilter() {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');

    function applyFilter(filter) {
      buttons.forEach(b => {
        b.classList.remove('bg-amber-500', 'text-black', 'font-bold');
        b.classList.add('bg-neutral-900', 'text-neutral-300');
      });

      const activeBtn = Array.from(buttons).find(b => 
        (b.getAttribute('data-filter') || '').toLowerCase() === filter.toLowerCase()
      );

      if (activeBtn) {
        activeBtn.classList.remove('bg-neutral-900', 'text-neutral-300');
        activeBtn.classList.add('bg-amber-500', 'text-black', 'font-bold');
      }

      // Rozdelenie aliasov (napr. "video editing,editing,strih videa")
      const targetAliases = filter.toLowerCase().split(',').map(s => s.trim());

      cards.forEach(card => {
        const rawSkillsAttr = card.getAttribute('data-skills') || '';
        const cardSkills = rawSkillsAttr.toLowerCase().split('|').map(s => s.trim());

        if (targetAliases.includes('all')) {
          card.classList.remove('hidden');
        } else {
          // Ak má karta aspoň jeden zo zhodných aliasov, zobrazíme ju
          const hasMatch = cardSkills.some(s => targetAliases.includes(s));
          if (hasMatch) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        }
      });
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const filter = btn.getAttribute('data-filter') || 'all';
        applyFilter(filter);
      });
    });

    const urlParams = new URLSearchParams(window.location.search);
    const targetSkill = urlParams.get('skill') || urlParams.get('filter');

    if (targetSkill) {
      applyFilter(targetSkill);
      setTimeout(() => {
        document.getElementById('projects-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 150);
    }
  }

  // Podpora pre Astro ViewTransitions aj klasický load
  setupProjectsFilter();
  document.addEventListener('astro:page-load', setupProjectsFilter);
</script>