    </form>
  </div>
</Layout>

<script>
import { parseSmartText } from '../utils/smartImporter.ts';

  const container = document.getElementById('reorderable-sections');
  const searchInput = document.getElementById('project-search') as HTMLInputElement | null;
  const searchResults = document.getElementById('search-results');
  const btnNewProject = document.getElementById('btn-new-project');
  const modeDot = document.getElementById('mode-dot');
  const modeText = document.getElementById('mode-text');
  const previewLink = document.getElementById('preview-link') as HTMLAnchorElement | null;
  const editingSlugInput = document.getElementById('editing-slug') as HTMLInputElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const statusMsg = document.getElementById('status-msg');
  const awardsList = document.getElementById('awards-list');
  const btnAddAward = document.getElementById('btn-add-award');
  const form = document.getElementById('project-form') as HTMLFormElement | null;

  // NOVÁ INTELIGENTNÁ AUTO-FILL FUNKCIA
  function parseTextAndFill(raw: string) {
    if (!raw || !raw.trim()) return;

    const data = parseSmartText(raw);

    const setVal = (id: string, val: any) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
      if (el && val !== undefined && val !== null && String(val).trim()) {
        el.value = String(val).trim();
      }
    };

    setVal('title_en', data.title_en);
    setVal('title_sk', data.title_sk);
    setVal('slug', data.slug);
    setVal('date', data.date);
    setVal('client', data.client);
    setVal('collaborators', data.collaborators);
    setVal('skills', data.skills);
    setVal('place', data.place);
    setVal('venue', data.venue);

    const importStatus = document.getElementById('import-status');
    if (importStatus) {
      importStatus.classList.remove('hidden');
      importStatus.className = 'text-xs font-mono text-green-400 mt-3 block';
      importStatus.innerText = `✓ Rozpoznané: "${data.title_sk || data.title_en}" (${data.date || 'Bez dátumu'})`;
    }

    setTimeout(() => form?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 150);
  }

  // Drag & Drop a File Listeners
  document.getElementById('btn-browse-trigger')?.addEventListener('click', () => {
    document.getElementById('txt-file-input')?.click();
  });

  document.getElementById('txt-file-input')?.addEventListener('change', (e: any) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (evt) => parseTextAndFill(evt.target?.result as string);
      reader.readAsText(file);
    }
  });

  document.getElementById('btn-toggle-paste')?.addEventListener('click', () => {
    const pasteBox = document.getElementById('paste-box');
    pasteBox?.classList.toggle('hidden');
    if (!pasteBox?.classList.contains('hidden')) (document.getElementById('raw-paste-input') as HTMLTextAreaElement)?.focus();
  });

  document.getElementById('btn-parse-pasted')?.addEventListener('click', () => {
    parseTextAndFill((document.getElementById('raw-paste-input') as HTMLTextAreaElement)?.value || '');
    document.getElementById('paste-box')?.classList.add('hidden');
  });

  const txtDropZone = document.getElementById('txt-drop-zone');
  txtDropZone?.addEventListener('dragover', (e) => { e.preventDefault(); txtDropZone.classList.add('border-amber-500', 'bg-amber-500/5'); });
  txtDropZone?.addEventListener('dragleave', () => txtDropZone.classList.remove('border-amber-500', 'bg-amber-500/5'));
  txtDropZone?.addEventListener('drop', (e) => {
    e.preventDefault(); txtDropZone.classList.remove('border-amber-500', 'bg-amber-500/5');
    const file = e.dataTransfer?.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (evt) => parseTextAndFill(evt.target?.result as string);
      reader.readAsText(file);
    }
  });

  // (Zvyšok tvojho pôvodného kódu pre načítanie projektov, template selector a submit zostáva identický...)
</script>