---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Project Studio & CMS | Bogdan Perederii">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8 border-b border-neutral-800 pb-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-black tracking-tight">Project Studio & CMS</h1>
        <p class="text-xs font-mono text-neutral-400 mt-1">Manage project metadata, bilingual copy, and vertical layout blocks.</p>
      </div>
      <a href="/" class="text-xs font-mono text-neutral-500 hover:text-amber-400 transition-colors">← Back to Site</a>
    </div>

    <!-- 1. TOP COMMAND BAR -->
    <div class="mb-8 p-5 rounded-2xl border border-neutral-800 bg-neutral-900/60 shadow-xl space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
        <div class="md:col-span-8 relative">
          <label for="project-search" class="block text-xs font-mono uppercase text-amber-400 font-bold tracking-wider mb-1.5">Search & Edit Existing Project</label>
          <input type="text" id="project-search" autocomplete="off" placeholder="🔍 Search by title..." class="w-full bg-neutral-950 border border-neutral-700 rounded-xl px-4 py-2.5 text-sm text-white focus:border-amber-500 focus:outline-none" />
          <div id="search-results" class="hidden absolute top-full left-0 right-0 z-50 mt-1.5 max-h-64 overflow-y-auto bg-neutral-950 border border-neutral-750 rounded-xl shadow-2xl divide-y divide-neutral-850"></div>
        </div>
        <div class="md:col-span-4">
          <button type="button" id="btn-new-project" class="w-full py-2.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-mono text-xs border border-neutral-700 transition-all flex items-center justify-center gap-2">⚡ + New Blank Project</button>
        </div>
      </div>
      <div class="pt-3 border-t border-neutral-800/80 flex items-center justify-between text-xs font-mono">
        <div class="flex items-center gap-2">
          <span id="mode-dot" class="h-2 w-2 rounded-full bg-green-500"></span>
          <span id="mode-text" class="text-neutral-300 font-medium">Mode: Creating New Blank Project</span>
        </div>
        <a id="preview-link" href="#" target="_blank" class="hidden text-amber-400 hover:underline flex items-center gap-1">Open Live Project Page ↗</a>
      </div>
    </div>

    <!-- 2. TXT IMPORTER -->
    <div class="mb-8 p-5 rounded-2xl border-2 border-dashed border-neutral-700 bg-neutral-900/30" id="txt-drop-zone">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <span class="text-3xl p-2 rounded-xl bg-neutral-950 border border-neutral-800">📄</span>
          <div>
            <h3 class="text-sm font-bold text-white">Import from Text (.txt / .md) <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">Auto-Fill</span></h3>
            <p class="text-xs font-mono text-neutral-400 mt-0.5">Drop project notes here to fill the form.</p>
          </div>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <input type="file" id="txt-file-input" accept=".txt,.md,.text" class="hidden" />
          <button type="button" id="btn-browse-trigger" class="cursor-pointer px-4 py-2 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-mono text-xs border border-neutral-750 transition-colors w-full text-center">Browse .txt</button>
          <button type="button" id="btn-toggle-paste" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-black font-bold font-mono text-xs transition-colors cursor-pointer w-full text-center">Paste</button>
        </div>
      </div>
      <div id="paste-box" class="mt-4 pt-4 border-t border-neutral-800 hidden space-y-3">
        <textarea id="raw-paste-input" rows="6" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl p-3 text-xs font-mono text-white focus:border-amber-500 focus:outline-none"></textarea>
        <button type="button" id="btn-parse-pasted" class="px-4 py-2 rounded-lg bg-amber-500 text-black font-bold font-mono text-xs hover:bg-amber-400 transition-colors cursor-pointer">⚡ Parse and Fill</button>
      </div>
      <p id="import-status" class="text-xs font-mono mt-3 hidden"></p>
    </div>

    <!-- FORM -->
    <form id="project-form" data-base={import.meta.env.BASE_URL.replace(/\/$/, '')} class="space-y-8">
      <input type="hidden" id="editing-slug" value="" />

      <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-900/40">
        <label class="block text-xs font-mono text-amber-400 uppercase font-bold mb-2">Preset Template</label>
        <select id="template" class="w-full bg-neutral-900 border border-neutral-800 rounded-xl p-3 text-neutral-100 font-mono text-xs cursor-pointer focus:border-amber-500 focus:outline-none">
          <option value="animated-short">🎬 Animated Short / Film</option>
          <option value="photoreport">📸 Photo Report / Event</option>
          <option value="camerawork">🎥 Camera Work</option>
        </select>
      </div>

      <div class="p-6 rounded-2xl border border-neutral-850 bg-neutral-900/30 space-y-4">
        <div class="grid grid-cols-2 gap-4">
            <input type="text" id="title_en" required placeholder="Title (EN) *" class="bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white text-sm" />
            <input type="text" id="title_sk" required placeholder="Title (SK) *" class="bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white text-sm" />
        </div>
        <input type="text" id="slug" placeholder="Slug (auto)" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white font-mono text-xs" />
        <input type="text" id="date" required placeholder="Date *" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white text-sm" />
        <input type="text" id="skills" required placeholder="Skills (Comma separated) *" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-amber-400 font-mono text-xs" />
        <textarea id="tagline_en" placeholder="Tagline (EN)" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white text-xs"></textarea>
        <textarea id="tagline_sk" placeholder="Tagline (SK)" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white text-xs"></textarea>
      </div>

      <div id="reorderable-sections" class="space-y-6">
        <div id="sec-hero" data-block-id="hero" class="block-card p-4 border border-neutral-800 rounded-xl bg-neutral-900/20">
            <div class="flex justify-between items-center mb-3 font-mono text-[10px] text-amber-400 uppercase font-bold"><span class="block-badge">1</span> 🎬 Hero Media <button type="button" class="btn-up">▲</button> <button type="button" class="btn-down">▼</button></div>
            <input type="text" id="heroUrl" placeholder="Media URL" class="w-full bg-neutral-950 p-2 text-xs text-neutral-300" />
        </div>
        <div id="sec-story" data-block-id="story" class="block-card p-4 border border-neutral-800 rounded-xl bg-neutral-900/20 space-y-2">
            <div class="flex justify-between items-center mb-3 font-mono text-[10px] text-amber-400 uppercase font-bold"><span class="block-badge">2</span> 📝 Story <button type="button" class="btn-up">▲</button> <button type="button" class="btn-down">▼</button></div>
            <textarea id="story_en" rows="3" placeholder="Story (EN)" class="w-full bg-neutral-950 p-2 text-xs text-neutral-300"></textarea>
            <textarea id="story_sk" rows="3" placeholder="Story (SK)" class="w-full bg-neutral-950 p-2 text-xs text-neutral-300"></textarea>
        </div>
        <div id="sec-awards" data-block-id="awards" class="block-card p-4 border border-neutral-800 rounded-xl bg-neutral-900/20">
            <div class="flex justify-between items-center mb-3 font-mono text-[10px] text-amber-400 uppercase font-bold"><span class="block-badge">3</span> 🌿 Awards <button type="button" class="btn-up">▲</button> <button type="button" class="btn-down">▼</button></div>
            <div id="awards-list" class="space-y-2"></div>
            <button type="button" id="btn-add-award" class="text-xs text-amber-500 font-mono mt-2">+ Add Award</button>
        </div>
        <div id="sec-teaser" data-block-id="teaser" class="block-card p-4 border border-neutral-800 rounded-xl bg-neutral-900/20">
            <div class="flex justify-between items-center mb-3 font-mono text-[10px] text-amber-400 uppercase font-bold"><span class="block-badge">4</span> ▶ Teaser <button type="button" class="btn-up">▲</button> <button type="button" class="btn-down">▼</button></div>
            <input type="text" id="teaserUrl" placeholder="Teaser URL" class="w-full bg-neutral-950 p-2 text-xs text-neutral-300" />
        </div>
        <div id="sec-bts" data-block-id="bts" class="block-card p-4 border border-neutral-800 rounded-xl bg-neutral-900/20">
            <div class="flex justify-between items-center mb-3 font-mono text-[10px] text-amber-400 uppercase font-bold"><span class="block-badge">5</span> ⚙️ BTS <button type="button" class="btn-up">▲</button> <button type="button" class="btn-down">▼</button></div>
            <textarea id="btsText" rows="3" placeholder="Media | Note | Gear" class="w-full bg-neutral-950 p-2 text-xs text-neutral-300"></textarea>
        </div>
        <div id="sec-gallery" data-block-id="gallery" class="block-card p-4 border border-neutral-800 rounded-xl bg-neutral-900/20">
            <div class="flex justify-between items-center mb-3 font-mono text-[10px] text-amber-400 uppercase font-bold"><span class="block-badge">6</span> 🖼️ Gallery <button type="button" class="btn-up">▲</button> <button type="button" class="btn-down">▼</button></div>
            <textarea id="galleryText" rows="3" placeholder="Image URLs" class="w-full bg-neutral-950 p-2 text-xs text-neutral-300"></textarea>
        </div>
      </div>

      <button type="submit" id="submit-btn" class="w-full py-4 bg-amber-500 text-black font-bold text-sm">⚡ Save Project File</button>
    </form>
  </div>
</Layout>

<script is:inline>
  // [INTEGROVANÝ JS PRE PARSER, ARRAGER, LOADER A SUBMIT]
  const container = document.getElementById('reorderable-sections');
  const awardsList = document.getElementById('awards-list');
  const btnAddAward = document.getElementById('btn-add-award');
  const editingSlugInput = document.getElementById('editing-slug');
  const modeDot = document.getElementById('mode-dot');
  const modeText = document.getElementById('mode-text');
  const previewLink = document.getElementById('preview-link');
  const submitBtn = document.getElementById('submit-btn');

  function updateCardBadges() {
    const cards = Array.from(container.children);
    cards.forEach((card, index) => {
      const badge = card.querySelector('.block-badge');
      if (badge) badge.innerText = String(index + 1);
    });
  }

  container.addEventListener('click', (e) => {
    const target = e.target;
    if (target.classList.contains('btn-up')) {
      const card = target.closest('.block-card');
      if (card.previousElementSibling) container.insertBefore(card, card.previousElementSibling);
      updateCardBadges();
    } else if (target.classList.contains('btn-down')) {
      const card = target.closest('.block-card');
      if (card.nextElementSibling) container.insertBefore(card.nextElementSibling, card);
      updateCardBadges();
    }
  });

  function createAwardCard(data = {}) {
    const card = document.createElement('div');
    card.className = 'award-card p-3 border border-neutral-700 rounded bg-neutral-950 space-y-2';
    card.innerHTML = `
      <div class="flex justify-between items-center"><span class="text-[9px] font-mono uppercase text-amber-500">Award</span> <button type="button" class="btn-delete-award text-[10px] text-red-500">✕</button></div>
      <input type="text" class="award-festival w-full bg-neutral-900 p-1 text-[11px]" placeholder="Festival" value="${data.festival || ''}" />
      <input type="text" class="award-en w-full bg-neutral-900 p-1 text-[11px]" placeholder="Award EN" value="${data.award_en || data.award || ''}" />
      <input type="text" class="award-sk w-full bg-neutral-900 p-1 text-[11px]" placeholder="Award SK" value="${data.award_sk || data.award || ''}" />
      <input type="text" class="award-year w-full bg-neutral-900 p-1 text-[11px]" placeholder="Year" value="${data.year || ''}" />
    `;
    card.querySelector('.btn-delete-award').onclick = () => card.remove();
    awardsList.appendChild(card);
  }
  btnAddAward.onclick = () => createAwardCard();

  function parseTextAndFill(raw) {
    const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ''; };
    const extract = (key) => { const m = raw.match(new RegExp(`${key}:\\s*(.*)`, 'i')); return m ? m[1].trim() : ''; };
    setVal('title_en', extract('Title EN')); setVal('title_sk', extract('Title SK'));
    setVal('date', extract('Date')); setVal('skills', extract('Skills'));
    setVal('tagline_en', extract('Tagline EN')); setVal('tagline_sk', extract('Tagline SK'));
    setVal('heroUrl', extract('Hero URL'));
  }

  document.getElementById('btn-browse-trigger').onclick = () => document.getElementById('txt-file-input').click();
  document.getElementById('txt-file-input').onchange = (e) => {
    const reader = new FileReader();
    reader.onload = (evt) => parseTextAndFill(evt.target.result);
    reader.readAsText(e.target.files[0]);
  };
  document.getElementById('btn-toggle-paste').onclick = () => document.getElementById('paste-box').classList.toggle('hidden');
  document.getElementById('btn-parse-pasted').onclick = () => parseTextAndFill(document.getElementById('raw-paste-input').value);

  document.getElementById('project-form').onsubmit = async (e) => {
    e.preventDefault();
    submitBtn.innerText = "Saving...";
    const currentOrder = Array.from(container.children).map(c => c.getAttribute('data-block-id'));
    const payload = {
        title_en: document.getElementById('title_en').value,
        title_sk: document.getElementById('title_sk').value,
        slug: editingSlugInput.value || document.getElementById('slug').value,
        date: document.getElementById('date').value,
        skills: document.getElementById('skills').value,
        tagline_en: document.getElementById('tagline_en').value,
        tagline_sk: document.getElementById('tagline_sk').value,
        heroUrl: document.getElementById('heroUrl').value,
        blockOrder: currentOrder
    };
    const res = await fetch(`${document.getElementById('project-form').dataset.base}/api/create-project`, {
        method: 'POST', body: JSON.stringify(payload)
    });
    const resData = await res.json();
    if(resData.success) { 
        submitBtn.innerText = "⚡ Saved!";
        setTimeout(() => submitBtn.innerText = "⚡ Save Project File (.mdx)", 2000);
    }
  };
</script>