---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Project Studio & CMS | Bogdan Perederii">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8 border-b border-neutral-800 pb-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-black tracking-tight">Project Studio & CMS</h1>
        <p class="text-xs font-mono text-neutral-400 mt-1">Manage project metadata, bilingual copy, and vertical layout blocks.</p>
      </div>
      <a href="/" class="text-xs font-mono text-neutral-500 hover:text-amber-400 transition-colors">← Back to Site</a>
    </div>

    <!-- 1. TOP COMMAND BAR: SEARCH & EDIT vs. NEW PROJECT -->
    <div class="mb-8 p-5 rounded-2xl border border-neutral-800 bg-neutral-900/60 shadow-xl space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
        <!-- Search to Edit (8 cols) -->
        <div class="md:col-span-8 relative">
          <label for="project-search" class="block text-xs font-mono uppercase text-amber-400 font-bold tracking-wider mb-1.5">
            Search & Edit Existing Project
          </label>
          <div class="relative">
            <input 
              type="text" 
              id="project-search" 
              autocomplete="off"
              placeholder="🔍 Search by title, client, or skill (e.g. Majster, STVR, Fest)..." 
              class="w-full bg-neutral-950 border border-neutral-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-neutral-500 focus:border-amber-500 focus:outline-none font-sans"
            />
            <div id="search-results" class="hidden absolute top-full left-0 right-0 z-50 mt-1.5 max-h-64 overflow-y-auto bg-neutral-950 border border-neutral-750 rounded-xl shadow-2xl divide-y divide-neutral-850"></div>
          </div>
        </div>

        <!-- Start Blank Project Button (4 cols) -->
        <div class="md:col-span-4">
          <button 
            type="button" 
            id="btn-new-project" 
            class="w-full py-2.5 px-4 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-200 hover:text-white font-mono text-xs border border-neutral-700 hover:border-amber-500/50 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>⚡</span>
            <span>+ New Blank Project</span>
          </button>
        </div>
      </div>

      <!-- Active Mode Indicator Banner -->
      <div class="pt-3 border-t border-neutral-800/80 flex items-center justify-between text-xs font-mono">
        <div class="flex items-center gap-2">
          <span id="mode-dot" class="h-2 w-2 rounded-full bg-green-500"></span>
          <span id="mode-text" class="text-neutral-300 font-medium">Mode: Creating New Blank Project</span>
        </div>
        <a id="preview-link" href="#" target="_blank" class="hidden text-amber-400 hover:underline flex items-center gap-1">
          Open Live Project Page ↗
        </a>
      </div>
    </div>

    <!-- 2. SMART TXT DOCUMENT AUTO-FILLER -->
    <div class="mb-8 p-5 rounded-2xl border-2 border-dashed border-neutral-700 bg-neutral-900/30 text-left transition-colors" id="txt-drop-zone">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <span class="text-3xl p-2 rounded-xl bg-neutral-950 border border-neutral-800">📄</span>
          <div>
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              Import from Text File (.txt / .md)
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">Auto-Fill</span>
            </h3>
            <p class="text-xs font-mono text-neutral-400 mt-0.5">
              Drop your project notes text file here or use buttons to auto-fill the form instantly.
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 w-full sm:w-auto">
          <input type="file" id="txt-file-input" accept=".txt,.md,.text" class="hidden" />
          <button type="button" id="btn-browse-trigger" class="cursor-pointer px-4 py-2 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-mono text-xs border border-neutral-700 transition-colors w-full sm:w-auto text-center">
            Browse .txt
          </button>
          <button type="button" id="btn-toggle-paste" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-black font-bold font-mono text-xs transition-colors cursor-pointer w-full sm:w-auto text-center">
            Paste Text
          </button>
        </div>
      </div>

      <!-- Quick Paste Textarea -->
      <div id="paste-box" class="mt-4 pt-4 border-t border-neutral-800 hidden space-y-3">
        <label class="block text-xs font-mono text-neutral-400">Paste your raw text notes below:</label>
        <textarea id="raw-paste-input" rows="6" placeholder="Title EN: The Master&#10;Title SK: Majster&#10;Skills: Stop-Motion, Réžia..." class="w-full bg-neutral-950 border border-neutral-800 rounded-xl p-3 text-xs font-mono text-white focus:border-amber-500 focus:outline-none"></textarea>
        <button type="button" id="btn-parse-pasted" class="px-4 py-2 rounded-lg bg-amber-500 text-black font-bold font-mono text-xs hover:bg-amber-400 transition-colors cursor-pointer">
          ⚡ Parse and Fill Form
        </button>
      </div>

      <p id="import-status" class="text-xs font-mono mt-3 hidden"></p>
    </div>

    <!-- PROJECT EDIT FORM -->
    <form id="project-form" data-base={import.meta.env.BASE_URL.replace(/\/$/, '')} class="space-y-8">
      <input type="hidden" id="editing-slug" value="" />

      <!-- TEMPLATE PRESET SELECTOR -->
      <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-900/40 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <label for="template" class="block text-xs font-mono text-amber-400 uppercase font-bold tracking-wider mb-1">
            Preset Template
          </label>
          <p class="text-[11px] font-mono text-neutral-500">
            Pre-arranges layout blocks for your chosen medium. You can still re-order them individually.
          </p>
        </div>
        <select id="template" class="w-full md:w-auto bg-neutral-900 border border-neutral-800 rounded-xl p-3 text-neutral-100 font-mono text-xs cursor-pointer focus:border-amber-500 focus:outline-none">
          <option value="animated-short">🎬 Animated Short / Film (Film + Laurels + Teaser + BTS)</option>
          <option value="photoreport">📸 Photo Report / Event (Hero Photo + Stills Gallery + Venue)</option>
          <option value="camerawork">🎥 Camera Work (Master Video + Gear Package + Rigging)</option>
        </select>
      </div>

      <!-- PINNED BASE METADATA -->
      <div class="p-6 rounded-2xl border border-neutral-850 bg-neutral-900/30 space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-neutral-800">
          <h2 class="text-xs font-mono uppercase tracking-widest text-amber-400 font-bold flex items-center gap-2">
            <span>📌</span> Base Information
          </h2>
          <span class="text-[10px] font-mono text-neutral-500">Fixed at top of case study</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-mono text-neutral-400 mb-1">Title (English) *</label>
            <input type="text" id="title_en" required placeholder="e.g. The Master" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-mono text-neutral-400 mb-1">Title (Slovak) *</label>
            <input type="text" id="title_sk" required placeholder="e.g. Majster" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-mono text-neutral-400 mb-1">URL Slug (Locked on Edit)</label>
            <input type="text" id="slug" placeholder="e.g. master (auto-generated)" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-mono text-neutral-400 mb-1">Date / Timeline *</label>
            <input type="text" id="date" required placeholder="e.g. 2024 - 2025" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-mono text-neutral-400 mb-1">Runtime / Duration</label>
            <input type="text" id="duration" placeholder="e.g. 3:20 min" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs" />
          </div>
          <div>
            <label class="block text-xs font-mono text-neutral-400 mb-1">Location</label>
            <input type="text" id="place" placeholder="e.g. Košice, Slovakia" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-mono text-neutral-400 mb-1">Venue (Optional)</label>
            <input type="text" id="venue" placeholder="e.g. Fest Anča / Stanica Žilina" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-mono text-neutral-400 mb-1">Client / Production</label>
            <input type="text" id="client" placeholder="e.g. SŠUP filmová / Independent" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-mono text-amber-400 mb-1 uppercase font-bold">Skills / Tags (Comma separated) *</label>
          <input type="text" id="skills" required placeholder="Stop-Motion, Réžia, Strih videa, Zvukový dizajn" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-amber-400 font-mono text-xs focus:border-amber-500 focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-mono text-neutral-400 mb-1">Collaborators (Comma separated)</label>
          <input type="text" id="collaborators" placeholder="Autor: Bogdan Perederii, Dabing: Natália Kocsisová" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
          <div>
            <label class="block text-xs font-mono text-neutral-400 mb-1">Tagline (English)</label>
            <textarea id="tagline_en" rows="2" placeholder="Short description in English" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none leading-relaxed"></textarea>
          </div>
          <div>
            <label class="block text-xs font-mono text-neutral-400 mb-1">Tagline (Slovak)</label>
            <textarea id="tagline_sk" rows="2" placeholder="Krátky popis v slovenčine" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none leading-relaxed"></textarea>
          </div>
        </div>

        <div>
          <label class="block text-xs font-mono text-neutral-400 mb-1">Card Cover Thumbnail URL (Direct image link) *</label>
          <input type="text" id="coverImage" required placeholder="https://i.ibb.co/.../cover.webp or /images/..." class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs" />
        </div>
      </div>

      <!-- RE-ORDERABLE SECTION CARDS -->
      <div class="flex items-center justify-between pt-4 border-t border-neutral-800">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-300 font-bold">
            Layout Blocks & Content
          </h2>
          <p class="text-[11px] font-mono text-neutral-500">Arrange block sequence using ▲ / ▼ buttons</p>
        </div>
      </div>

      <div id="reorderable-sections" class="space-y-6">
        
        <!-- CARD 1: MASTER HERO MEDIA -->
        <div id="sec-hero" data-block-id="hero" class="block-card p-6 rounded-2xl border border-neutral-800 bg-neutral-900/30 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-neutral-800 bg-neutral-900/60 p-3 rounded-xl">
            <div class="flex items-center gap-2.5">
              <span class="block-badge text-xs font-mono px-2 py-0.5 rounded bg-neutral-800 text-amber-400 font-bold">#</span>
              <span class="text-base">🎬</span>
              <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-200 font-bold">Master Media (Full Film / Hero Photo)</h3>
            </div>
            <div class="flex items-center gap-1">
              <button type="button" class="btn-up px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▲ Up</button>
              <button type="button" class="btn-down px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▼ Down</button>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="md:col-span-1">
              <label class="block text-xs font-mono text-neutral-400 mb-1">Type</label>
              <select id="heroType" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs">
                <option value="video">Video</option>
                <option value="photo">Photo</option>
              </select>
            </div>
            <div class="md:col-span-3">
              <div class="flex justify-between items-end mb-1">
                <label class="block text-xs font-mono text-neutral-400">Main Media URL</label>
                <button type="button" id="btn-add-hero2" class="text-[10px] font-mono text-amber-500 hover:text-amber-400">+ Add 2nd Video</button>
              </div>
              <input type="text" id="heroUrl" placeholder="https://www.youtube.com/watch?v=... or direct image link" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs" />
            </div>
          </div>

          <!-- Hidden 2nd Video Box -->
          <div id="hero-2-box" class="hidden pt-4 mt-4 border-t border-neutral-800 grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="md:col-span-1">
              <label class="block text-xs font-mono text-neutral-400 mb-1">Layout</label>
              <select id="heroLayout" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs">
                <option value="grid">Side by Side</option>
                <option value="stacked">One Above Other</option>
              </select>
            </div>
            <div class="md:col-span-3">
              <div class="flex justify-between items-end mb-1">
                <label class="block text-xs font-mono text-neutral-400">Second Video URL</label>
                <button type="button" id="btn-remove-hero2" class="text-[10px] font-mono text-red-500 hover:text-red-400">✕ Remove</button>
              </div>
              <input type="text" id="heroUrl2" placeholder="Second video URL..." class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs" />
            </div>
          </div>
        </div>

        <!-- CARD 2: BILINGUAL STORY / STATEMENT -->
        <div id="sec-story" data-block-id="story" class="block-card p-6 rounded-2xl border border-neutral-800 bg-neutral-900/30 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-neutral-800 bg-neutral-900/60 p-3 rounded-xl">
            <div class="flex items-center gap-2.5">
              <span class="block-badge text-xs font-mono px-2 py-0.5 rounded bg-neutral-800 text-amber-400 font-bold">#</span>
              <span class="text-base">📝</span>
              <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-200 font-bold">Story & Statement (Bilingual)</h3>
            </div>
            <div class="flex items-center gap-1">
              <button type="button" class="btn-up px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▲ Up</button>
              <button type="button" class="btn-down px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▼ Down</button>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-mono text-neutral-400 mb-1">Story / Director's Statement (English)</label>
              <textarea id="story_en" rows="8" placeholder="Story, background, and artistic process in English..." class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-3.5 text-white focus:border-amber-500 focus:outline-none font-sans text-sm leading-relaxed resize-y min-h-[160px]"></textarea>
            </div>
            <div>
              <label class="block text-xs font-mono text-neutral-400 mb-1">Story / Director's Statement (Slovak)</label>
              <textarea id="story_sk" rows="8" placeholder="Príbeh, pozadie a tvorivý proces v slovenčine..." class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-3.5 text-white focus:border-amber-500 focus:outline-none font-sans text-sm leading-relaxed resize-y min-h-[160px]"></textarea>
            </div>
          </div>
        </div>

        <!-- CARD 3: DEDICATED AWARDS & LAURELS BUILDER -->
        <div id="sec-awards" data-block-id="awards" class="block-card p-6 rounded-2xl border border-neutral-800 bg-neutral-900/30 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-neutral-800 bg-neutral-900/60 p-3 rounded-xl">
            <div class="flex items-center gap-2.5">
              <span class="block-badge text-xs font-mono px-2 py-0.5 rounded bg-neutral-800 text-amber-400 font-bold">#</span>
              <span class="text-base">🌿</span>
              <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-200 font-bold">Awards & Festival Selections</h3>
            </div>
            <div class="flex items-center gap-1">
              <button type="button" class="btn-up px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▲ Up</button>
              <button type="button" class="btn-down px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▼ Down</button>
            </div>
          </div>

          <!-- DYNAMIC LIST OF AWARD CARDS -->
          <div id="awards-list" class="space-y-4"></div>

          <button type="button" id="btn-add-award" class="w-full py-3 rounded-xl border border-dashed border-neutral-700 hover:border-amber-500 bg-neutral-900/40 hover:bg-neutral-900 text-neutral-300 hover:text-amber-400 font-mono text-xs transition-all flex items-center justify-center gap-2 cursor-pointer">
            <span>+</span><span>Add Another Award / Selection</span>
          </button>
        </div>

        <!-- CARD 4: BILINGUAL TEASER TRAILER -->
        <div id="sec-teaser" data-block-id="teaser" class="block-card p-6 rounded-2xl border border-neutral-800 bg-neutral-900/30 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-neutral-800 bg-neutral-900/60 p-3 rounded-xl">
            <div class="flex items-center gap-2.5">
              <span class="block-badge text-xs font-mono px-2 py-0.5 rounded bg-neutral-800 text-amber-400 font-bold">#</span>
              <span class="text-base">▶</span>
              <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-200 font-bold">Festival Screening Teaser</h3>
            </div>
            <div class="flex items-center gap-1">
              <button type="button" class="btn-up px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▲ Up</button>
              <button type="button" class="btn-down px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▼ Down</button>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-mono text-neutral-400 mb-1">Teaser Title (English)</label>
              <input type="text" id="teaserTitle_en" placeholder="e.g. Screening Teaser: Master Returns" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs" />
            </div>
            <div>
              <label class="block text-xs font-mono text-neutral-400 mb-1">Teaser Title (Slovak)</label>
              <input type="text" id="teaserTitle_sk" placeholder="e.g. Festivalový teaser: Majster sa vráti" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs" />
            </div>
            <div>
              <label class="block text-xs font-mono text-neutral-400 mb-1">Teaser Video URL</label>
              <input type="text" id="teaserUrl" placeholder="https://www.youtube.com/watch?v=..." class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs" />
            </div>
          </div>
        </div>

        <!-- CARD 5: BILINGUAL BTS & GEAR -->
        <div id="sec-bts" data-block-id="bts" class="block-card p-6 rounded-2xl border border-neutral-800 bg-neutral-900/30 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-neutral-800 bg-neutral-900/60 p-3 rounded-xl">
            <div class="flex items-center gap-2.5">
              <span class="block-badge text-xs font-mono px-2 py-0.5 rounded bg-neutral-800 text-amber-400 font-bold">#</span>
              <span class="text-base">⚙️</span>
              <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-200 font-bold">Behind The Scenes & Equipment</h3>
            </div>
            <div class="flex items-center gap-1">
              <button type="button" class="btn-up px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▲ Up</button>
              <button type="button" class="btn-down px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▼ Down</button>
            </div>
          </div>

          <div>
            <label class="block text-xs font-mono text-neutral-400 mb-1">Complete Gear Package (Comma separated)</label>
            <input type="text" id="gearList" placeholder="Sony NEX-5T, TTArtisan 35mm f/1.4, Røde VideoMic Pro" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2.5 text-white focus:border-amber-500 focus:outline-none font-mono text-xs mb-3" />
          </div>

          <div class="p-3 rounded-lg bg-neutral-950 border border-neutral-800 text-neutral-400 text-xs font-mono">
            <strong>Format guide:</strong> 1 BTS item per line separated by pipe (<code class="text-amber-400">|</code>):<br />
            <span class="text-neutral-500">MediaURL | Note (EN) | Note (SK) | GearUsed (optional)</span>
          </div>

          <textarea id="btsText" rows="5" placeholder="https://i.ibb.co/.../bts.webp | Crafting wooden armature joints | Výroba kĺbov bábky | Sony NEX-5T" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-3 text-white focus:border-amber-500 focus:outline-none font-mono text-xs leading-relaxed min-h-[140px]"></textarea>
        </div>

        <!-- CARD 6: GALLERY / STILLS -->
        <div id="sec-gallery" data-block-id="gallery" class="block-card p-6 rounded-2xl border border-neutral-800 bg-neutral-900/30 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-neutral-800 bg-neutral-900/60 p-3 rounded-xl">
            <div class="flex items-center gap-2.5">
              <span class="block-badge text-xs font-mono px-2 py-0.5 rounded bg-neutral-800 text-amber-400 font-bold">#</span>
              <span class="text-base">🖼️</span>
              <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-200 font-bold">Photo Gallery Stills</h3>
            </div>
            <div class="flex items-center gap-1">
              <button type="button" class="btn-up px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▲ Up</button>
              <button type="button" class="btn-down px-3 py-1 text-xs font-mono rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">▼ Down</button>
            </div>
          </div>

          <p class="text-[11px] font-mono text-neutral-500">Paste direct image links (1 per line):</p>
          <textarea id="galleryText" rows="5" placeholder="https://i.ibb.co/.../still-1.webp&#10;https://i.ibb.co/.../still-2.webp" class="w-full bg-neutral-900 border border-neutral-800 rounded-lg p-3 text-white focus:border-amber-500 focus:outline-none font-mono text-xs leading-relaxed min-h-[140px]"></textarea>
        </div>

      </div>

      <!-- BOTTOM SAVE / SUBMIT DOCK -->
      <div class="pt-8 border-t border-neutral-800 sticky bottom-4 z-40">
        <div class="p-4 rounded-2xl bg-neutral-950/95 backdrop-blur border border-neutral-800 shadow-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs font-mono">
            <p id="status-msg" class="text-neutral-400 font-medium">Ready to save</p>
          </div>
          <button type="submit" id="submit-btn" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-amber-500 text-black font-bold font-mono tracking-wider hover:bg-amber-400 transition-all shadow-lg hover:shadow-amber-500/20 cursor-pointer text-sm">
            ⚡ Save Project File (.mdx)
          </button>
        </div>
      </div>
    </form>
  </div>
</Layout>

<script is:inline>
  // 1. SMART TEXT PARSER (Priamo v skripte, bez problémových importov)
  function slugifyText(text) {
    return text.toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim().replace(/[^a-z0-9\s-]/g, '').replace(/[\s_-]+/g, '-').replace(/^-+|-+$/g, '');
  }

  function parseSmartText(raw) {
    if (!raw || !raw.trim()) return {};
    const cleanRaw = raw.replace(/^---\s*[\r\n]+/, '').replace(/[\r\n]+---\s*$/, '');
    const lines = cleanRaw.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
    const result = { title_en: '', title_sk: '', slug: '', date: '', client: '', skills: '', collaborators: '', place: '', venue: '' };

    const unassigned = [];
    for (const line of lines) {
      if (!result.date && /^((19|20)\d{2})(\s*[-–]\s*(19|20)\d{2})?$/.test(line)) {
        result.date = line; continue;
      }
      if (/(autor|dramaturgia|obsadenie|hrajú|réžia|kamera|zvuk|strih|cast):/i.test(line)) {
        result.collaborators = result.collaborators ? `${result.collaborators}, ${line}` : line; continue;
      }
      if (!result.client && /(divadlo|theatre|studio|galéria|kunsthalle|s\.r\.o\.|kft\.|tv\b|aliancia)/i.test(line)) {
        result.client = line; continue;
      }
      unassigned.push(line);
    }

    const hasDiacritics = (str) => /[áäčďéíĺľňóôŕšťúýž]/i.test(str);
    const hasEnWords = (str) => /\b(the|of|in|and|man|green|adventures|short|film|night)\b/i.test(str);

    if (unassigned.length === 1) {
      result.title_sk = unassigned[0];
      result.title_en = unassigned[0];
    } else if (unassigned.length >= 2) {
      if (hasDiacritics(unassigned[0]) || hasEnWords(unassigned[1])) {
        result.title_sk = unassigned[0]; result.title_en = unassigned[1];
      } else if (hasDiacritics(unassigned[1]) || hasEnWords(unassigned[0])) {
        result.title_sk = unassigned[1]; result.title_en = unassigned[0];
      } else {
        result.title_sk = unassigned[0]; result.title_en = unassigned[1];
      }
    }

    const mainTitle = result.title_sk || result.title_en;
    if (mainTitle) result.slug = slugifyText(mainTitle);
    if (!result.skills && /divadlo/i.test(cleanRaw)) result.skills = 'Záznam predstavenia, Kamera, Strih videa';

    return result;
  }

  // 2. DOM ELEMENTY
  const container = document.getElementById('reorderable-sections');
  const searchInput = document.getElementById('project-search');
  const searchResults = document.getElementById('search-results');
  const btnNewProject = document.getElementById('btn-new-project');
  const modeDot = document.getElementById('mode-dot');
  const modeText = document.getElementById('mode-text');
  const previewLink = document.getElementById('preview-link');
  const editingSlugInput = document.getElementById('editing-slug');
  const submitBtn = document.getElementById('submit-btn');
  const statusMsg = document.getElementById('status-msg');
  const awardsList = document.getElementById('awards-list');
  const btnAddAward = document.getElementById('btn-add-award');
  const projectForm = document.getElementById('project-form');

  // AUTO-FILL LOGIKA
  function parseTextAndFill(raw) {
    if (!raw || !raw.trim()) return;
    const data = parseSmartText(raw);

    const setVal = (id, val) => {
      const el = document.getElementById(id);
      if (el && val) el.value = String(val).trim();
    };

    setVal('title_en', data.title_en);
    setVal('title_sk', data.title_sk);
    setVal('slug', data.slug);
    setVal('date', data.date);
    setVal('client', data.client);
    setVal('collaborators', data.collaborators);
    setVal('skills', data.skills);

    const importStatus = document.getElementById('import-status');
    if (importStatus) {
      importStatus.classList.remove('hidden');
      importStatus.className = 'text-xs font-mono text-green-400 mt-3 block';
      importStatus.innerText = `✓ Rozpoznané: "${data.title_sk || data.title_en}" (${data.date || 'Bez dátumu'})`;
    }
  }

  // Listeners pre súbory a paste
  document.getElementById('btn-browse-trigger')?.addEventListener('click', () => document.getElementById('txt-file-input')?.click());
  document.getElementById('txt-file-input')?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (evt) => parseTextAndFill(evt.target.result);
      reader.readAsText(file);
    }
  });

  document.getElementById('btn-toggle-paste')?.addEventListener('click', () => {
    document.getElementById('paste-box')?.classList.toggle('hidden');
  });
  document.getElementById('btn-parse-pasted')?.addEventListener('click', () => {
    parseTextAndFill(document.getElementById('raw-paste-input')?.value);
    document.getElementById('paste-box')?.classList.add('hidden');
  });

  // SUBMIT HANDLER - SO 100% BLOKOVANÍM RELOADU
  projectForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    e.stopPropagation();

    if (!submitBtn) return;
    submitBtn.disabled = true;
    submitBtn.innerText = "Saving to disk...";
    statusMsg.className = "text-neutral-400 animate-pulse text-xs mt-3 block";
    statusMsg.innerText = "Writing changes to .mdx file...";

    const targetSlug = editingSlugInput.value.trim() || document.getElementById('slug').value.trim() || slugifyText(document.getElementById('title_sk').value || document.getElementById('title_en').value);
    const currentOrder = container ? Array.from(container.children).map(card => card.getAttribute('data-block-id')).filter(Boolean) : [];

    const payload = {
      title_en: document.getElementById('title_en').value,
      title_sk: document.getElementById('title_sk').value,
      slug: targetSlug,
      date: document.getElementById('date').value,
      duration: document.getElementById('duration').value,
      place: document.getElementById('place').value,
      venue: document.getElementById('venue').value,
      client: document.getElementById('client').value,
      skills: document.getElementById('skills').value,
      collaborators: document.getElementById('collaborators').value,
      tagline_en: document.getElementById('tagline_en').value,
      tagline_sk: document.getElementById('tagline_sk').value,
      story_en: document.getElementById('story_en').value,
      story_sk: document.getElementById('story_sk').value,
      coverImage: document.getElementById('coverImage').value,
      heroType: document.getElementById('heroType').value,
      heroUrl: document.getElementById('heroUrl').value,
      heroUrl2: document.getElementById('heroUrl2')?.value || '',
      heroLayout: document.getElementById('heroLayout')?.value || 'grid',
      teaserTitle_en: document.getElementById('teaserTitle_en').value,
      teaserTitle_sk: document.getElementById('teaserTitle_sk').value,
      teaserUrl: document.getElementById('teaserUrl').value,
      gearList: document.getElementById('gearList').value,
      btsText: document.getElementById('btsText').value,
      galleryText: document.getElementById('galleryText').value,
      awards: typeof getAwardsData === 'function' ? getAwardsData() : [],
      blockOrder: currentOrder,
    };

    try {
      const res = await fetch(`${projectForm.dataset.base}/api/create-project`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const text = await res.text();
      let result;
      try { result = JSON.parse(text); } catch (jsonErr) { throw new Error(`Server error (${res.status}): ${text || 'Empty response'}`); }

      if (result.success) {
        statusMsg.className = "text-green-400 font-medium text-xs mt-3 block";
        statusMsg.innerText = `✓ Projekt ${result.slug}.mdx bol úspešne vytvorený na disku!`;
        submitBtn.disabled = false;
        submitBtn.innerText = `💾 Update & Save ${result.slug}.mdx`;
      } else {
        throw new Error(result.error);
      }
    } catch (err) {
      statusMsg.className = "text-red-500 font-medium text-xs mt-3 block";
      statusMsg.innerText = `Error: ${err.message}`;
      submitBtn.disabled = false;
      submitBtn.innerText = "⚡ Try Saving Again";
    }
  });
</script>