---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry: any) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const allProjects: any[] = await getCollection('projects');
const { entry } = Astro.props as { entry: any };
const { Content } = await render(entry);
const d = entry.data;

// Automatic Related Projects by Skill Overlap
const currentSkills: string[] = d.skills || [];
const relatedProjects = allProjects
  .filter((p: any) => p.id !== entry.id)
  .map((p: any) => ({
    project: p,
    matchScore: (p.data.skills || []).filter((s: string) => currentSkills.includes(s)).length,
  }))
  .filter((item: any) => item.matchScore > 0)
  .sort((a: any, b: any) => b.matchScore - a.matchScore)
  .slice(0, 2)
  .map((item: any) => item.project);

function getEmbedUrl(url: string) {
  if (!url) return "";
  if (url.includes("youtube.com") || url.includes("youtu.be")) {
    const id = url.includes("v=") ? url.split("v=")[1].split("&")[0] : url.split("/").pop();
    return `https://www.youtube-nocookie.com/embed/${id}`;
  } else if (url.includes("vimeo.com")) {
    const id = url.split("/").pop();
    return `https://player.vimeo.com/video/${id}?title=0&byline=0`;
  }
  return url;
}

const order: string[] = d.blockOrder || ['hero', 'story', 'awards', 'teaser', 'gallery', 'bts'];
---

<Layout title={`${d.title_en || d.title} | Bogdan Perederii`}>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <a href="/" class="text-xs font-mono text-neutral-500 hover:text-amber-400 mb-8 inline-block">
      <span class="lang-en">← Back to Portfolio</span>
      <span class="lang-sk hidden">← Späť na portfólio</span>
    </a>

    <!-- BASE HEADER -->
    <header class="border-b border-neutral-800 pb-8 mb-10">
      <div class="flex flex-wrap gap-2 mb-4">
        {d.skills.map((s: string) => (
          <span class="px-2 py-0.5 text-xs font-mono bg-neutral-900 border border-neutral-800 text-amber-400 rounded">
            {s}
          </span>
        ))}
      </div>

      <h1 class="text-4xl md:text-6xl font-black tracking-tight mb-4">
        <span class="lang-en">{d.title_en || d.title}</span>
        <span class="lang-sk hidden">{d.title_sk || d.title}</span>
      </h1>
      
      <p class="text-lg text-neutral-300 leading-relaxed mb-6">
        <span class="lang-en">{d.tagline_en}</span>
        <span class="lang-sk hidden">{d.tagline_sk}</span>
      </p>

      <!-- Meta Grid -->
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 p-4 rounded-xl bg-neutral-900/50 border border-neutral-800 text-xs font-mono text-neutral-400">
        <div>
          <span class="text-neutral-600 block text-[10px] uppercase">
            <span class="lang-en">Date:</span><span class="lang-sk hidden">Dátum:</span>
          </span> 
          {d.date}
        </div>
        {d.duration && (
          <div>
            <span class="text-neutral-600 block text-[10px] uppercase">
              <span class="lang-en">Runtime:</span><span class="lang-sk hidden">Dĺžka:</span>
            </span> 
            <strong class="text-amber-400">{d.duration}</strong>
          </div>
        )}
        <div>
          <span class="text-neutral-600 block text-[10px] uppercase">
            <span class="lang-en">Location:</span><span class="lang-sk hidden">Miesto:</span>
          </span> 
          {d.place}
        </div>
        {d.venue && (
          <div>
            <span class="text-neutral-600 block text-[10px] uppercase">Venue:</span> 
            {d.venue}
          </div>
        )}
        {d.client && (
          <div>
            <span class="text-neutral-600 block text-[10px] uppercase">
              <span class="lang-en">Client:</span><span class="lang-sk hidden">Klient:</span>
            </span> 
            <strong class="text-neutral-200">{d.client}</strong>
          </div>
        )}
      </div>

      {d.collaborators && d.collaborators.length > 0 && (
        <div class="mt-3 text-xs font-mono text-neutral-400">
          <span class="text-neutral-600">
            <span class="lang-en">Collaborators:</span>
            <span class="lang-sk hidden">Spolupráca:</span>
          </span> {d.collaborators.join(' • ')}
        </div>
      )}
    </header>

    <!-- DYNAMICALLY ORDERED BLOCKS -->
    {order.map((blockName) => {
      // 1. HERO MEDIA
      if (blockName === 'hero' && d.heroMedia) {
        return (
          <section class="mb-14">
            {d.heroMedia.type === 'video' ? (
              <div class="aspect-video w-full rounded-2xl overflow-hidden bg-neutral-900 border border-neutral-800 shadow-2xl">
                <iframe 
                  src={getEmbedUrl(d.heroMedia.url)} 
                  title={d.title_en || d.title} 
                  class="w-full h-full" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                  allowfullscreen
                />
              </div>
            ) : (
              <div class="rounded-2xl overflow-hidden border border-neutral-800 shadow-2xl">
                <img src={d.heroMedia.url} alt={d.title_en || d.title} class="w-full h-auto object-cover max-h-[600px]" />
              </div>
            )}
          </section>
        );
      }

      // 2. STORY / DIRECTOR'S STATEMENT
      if (blockName === 'story') {
        return (
          <div class="mb-16">
            {d.story_en && (
              <div class="lang-en prose prose-invert prose-neutral max-w-none text-neutral-300 leading-relaxed whitespace-pre-line">
                {d.story_en}
              </div>
            )}
            {d.story_sk && (
              <div class="lang-sk hidden prose prose-invert prose-neutral max-w-none text-neutral-300 leading-relaxed whitespace-pre-line">
                {d.story_sk}
              </div>
            )}
            <div class="prose prose-invert prose-neutral max-w-none text-neutral-300 leading-relaxed">
              <Content />
            </div>
          </div>
        );
      }

      // 3. AWARDS & LAURELS (Differentiated Icons: 🏆 for prizes, 🌿 for selections + Diploma/Laurel Photo Slot)
      if (blockName === 'awards' && d.awards && d.awards.length > 0) {
        return (
          <section class="mb-16 border-t border-neutral-800 pt-10">
            <h2 class="text-xs font-mono uppercase tracking-widest text-amber-500 mb-6">
              <span class="lang-en">Awards & Festival Selections</span>
              <span class="lang-sk hidden">Ocenenia a festivalové výbery</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 items-start">
              {d.awards.map((a: any) => {
                const textToCheck = `${a.award_en || ''} ${a.award_sk || ''} ${a.award || ''}`.toLowerCase();
                const isPrize = textToCheck.includes('award') || 
                                textToCheck.includes('place') || 
                                textToCheck.includes('cena') || 
                                textToCheck.includes('miesto') || 
                                textToCheck.includes('winner') || 
                                textToCheck.includes('víťaz');

                return (
                  <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-900/40 hover:border-neutral-700 transition-all flex flex-col justify-between h-full">
                    <div class="text-center">
                      <span class="text-2xl mb-2 inline-block">
                        {isPrize ? '🏆' : '🌿'}
                      </span>
                      <span class="text-[10px] font-mono uppercase tracking-wider text-amber-400 font-bold block mb-1.5">
                        <span class="lang-en">{a.award_en || a.award}</span>
                        <span class="lang-sk hidden">{a.award_sk || a.award}</span>
                      </span>
                      <h4 class="text-sm font-bold text-neutral-100 leading-snug">{a.festival}</h4>
                      <span class="text-xs font-mono text-neutral-500 mt-1 block">({a.year})</span>
                    </div>

                    {/* Displays image ONLY if laurelImage link is provided */}
                    {a.laurelImage && (
                      <div class="mt-5 pt-4 border-t border-neutral-800/80 flex items-center justify-center min-h-[120px]">
                        <a href={a.laurelImage} target="_blank" rel="noopener noreferrer" class="group block" title="Open image">
                          <img 
                            src={a.laurelImage} 
                            alt={`${a.festival} Laurel/Diploma`} 
                            class="max-h-32 w-auto max-w-full object-contain rounded filter drop-shadow group-hover:scale-105 transition-transform duration-300"
                            loading="lazy"
                          />
                        </a>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </section>
        );
      }

      // 4. TEASER TRAILER
      if (blockName === 'teaser' && d.teaserVideo) {
        return (
          <section class="mb-16 border-t border-neutral-800 pt-10">
            <div class="flex items-center gap-2 mb-4">
              <span class="text-amber-500 text-sm">▶</span>
              <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-300">
                <span class="lang-en">{d.teaserVideo.title_en}</span>
                <span class="lang-sk hidden">{d.teaserVideo.title_sk}</span>
              </h2>
            </div>
            <div class="aspect-video w-full rounded-2xl overflow-hidden bg-neutral-900 border border-neutral-800 shadow-2xl">
              <iframe 
                src={getEmbedUrl(d.teaserVideo.url)} 
                title={d.teaserVideo.title_en} 
                class="w-full h-full" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen
              />
            </div>
            {(d.teaserVideo.caption_en || d.teaserVideo.caption_sk) && (
              <p class="text-xs font-mono text-neutral-500 mt-2.5 text-center">
                <span class="lang-en">{d.teaserVideo.caption_en}</span>
                <span class="lang-sk hidden">{d.teaserVideo.caption_sk}</span>
              </p>
            )}
          </section>
        );
      }

      // 5. GALLERY
      if (blockName === 'gallery' && d.gallery && d.gallery.length > 0) {
        return (
          <section class="mb-16 border-t border-neutral-800 pt-10">
            <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-500 mb-6">
              <span class="lang-en">Gallery / Stills</span>
              <span class="lang-sk hidden">Galéria záberov</span>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {d.gallery.map((img: string, i: number) => (
                <div class="rounded-xl overflow-hidden border border-neutral-800 bg-neutral-900 group">
                  <img src={img} alt={`Gallery image ${i + 1}`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </div>
              ))}
            </div>
          </section>
        );
      }

      // 6. BTS & TECH BREAKDOWN
      if (blockName === 'bts' && (d.gearList.length > 0 || d.bts.length > 0)) {
        return (
          <section class="mb-16 border-t border-neutral-800 pt-10">
            <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-500 mb-6">
              <span class="lang-en">Behind The Scenes & Tech Breakdown</span>
              <span class="lang-sk hidden">Zákulisie & Technické vybavenie</span>
            </h2>
            
            {d.gearList && d.gearList.length > 0 && (
              <div class="mb-8 p-5 rounded-xl border border-neutral-800 bg-neutral-900/30">
                <h3 class="text-xs font-mono uppercase tracking-widest text-amber-500 mb-3 flex items-center gap-2">
                  <span>⚙️</span> 
                  <span class="lang-en">Production Gear Package</span>
                  <span class="lang-sk hidden">Použitá technika</span>
                </h3>
                <div class="flex flex-wrap gap-2">
                  {d.gearList.map((g: string) => (
                    <span class="px-2.5 py-1 text-xs font-mono bg-neutral-900 border border-neutral-800 text-neutral-300 rounded-md">
                      {g}
                    </span>
                  ))}
                </div>
              </div>
            )}

            {d.bts && d.bts.length > 0 && (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {d.bts.map((item: any) => (
                  <div class="border border-neutral-800 rounded-xl overflow-hidden bg-neutral-900/40">
                    <div class="aspect-video overflow-hidden bg-neutral-900">
                      <img src={item.media} alt="BTS" class="w-full h-full object-cover" loading="lazy" />
                    </div>
                    <div class="p-4 space-y-2">
                      <p class="text-sm text-neutral-300 leading-snug">
                        <span class="lang-en">{item.note_en}</span>
                        <span class="lang-sk hidden">{item.note_sk}</span>
                      </p>
                      {item.gear && (
                        <div class="pt-2 border-t border-neutral-800 flex items-center gap-1.5 text-xs font-mono text-neutral-400">
                          <span class="text-amber-500 font-bold">⚙️ Gear:</span>
                          <span>{item.gear}</span>
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </section>
        );
      }

      return null;
    })}

    <!-- BLOCK 5: AUTOMATIC RELATED PROJECTS -->
    {relatedProjects.length > 0 && (
      <section class="border-t border-neutral-800 pt-12 mt-12">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-400">
            <span class="lang-en">Related Projects</span>
            <span class="lang-sk hidden">Súvisiace projekty</span>
          </h2>
          <span class="text-xs font-mono text-neutral-600">Matched by shared skills</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedProjects.map((relProject: any) => (
            <ProjectCard project={relProject} />
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>